# Infosys Springboard Internship 7.0 Batch 4 - Milestone 1
# Local Environment Configuration Template
# Instructions: Copy this file to '.env' for local development. Never commit real credentials or '.env' to Git.
# In Google Colab: Configure these under the Secrets (key icon) sidebar tab instead.

# JWT Signing Secret (Provide a secure random string)
JWT_SECRET=your_jwt_secret_placeholder_replace_with_random_key

# ngrok Personal Authtoken (From https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=your_ngrok_authtoken_placeholder

# Official Google Gmail API OAuth 2.0 Credentials (HTTPS Port 443)
# Set these in Google Colab Secrets (or local .env) to deliver OTP emails without SMTP port 587 block
GMAIL_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_oauth_refresh_token
EMAIL_ADDRESS=your_registered_gmail_address@gmail.com

# Admin Portal Credentials (Set custom credentials for evaluator / admin access)
ADMIN_USERNAME=your_admin_username_placeholder
ADMIN_PASSWORD=your_admin_password_placeholder

# Optional persistent SQLite database path override
# DB_PATH=auth_system.db
